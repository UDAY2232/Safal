{
  "name": "safal-workspace",
  "version": "1.0.0",
  "description": "SAFAL EXPORT AND IMPORT PVT LTD - ERP Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend start"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.6",
    "@rollup/rollup-linux-x64-musl": "^4.64.6"
  }
}
