datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  VENDOR
}

enum WageType {
  MONTHLY
  DAILY
  HOURLY
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  OPEN
  CLOSED
  REJECTED
  CANCELLED
}

enum PODispatchStatus {
  PENDING_DISPATCH
  LOADED_AND_DISPATCHED
  IN_TRANSIT
  DELIVERED_AT_HUB
  REJECTED_TRANSIT
}

enum FinancialStatus {
  NOT_CALCULATED
  PENDING_COST_DATA
  PENDING_SALES_DATA
  IN_PROGRESS
  PROFIT
  LOSS
  BREAK_EVEN
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PARTIALLY_REIMBURSED
  PAID_CLEARED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  name             String
  role             Role               @default(EMPLOYEE)
  department       String?
  designation      String?
  phone            String?
  isActive         Boolean            @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  accountantProfile AccountantProfile?
  employee         Employee?
  vendorProfile    VendorProfile?
  createdPOs       PurchaseOrder[]    @relation("POCreator")
  approvedPOs      PurchaseOrder[]    @relation("POApprover")
  auditLogs        AuditLog[]
  notifications    Notification[]
  attendanceRecords AttendanceRecord[]

  @@map("users")
}

model AccountantProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountantId      String   @unique // e.g. ACC-001
  canCreatePO       Boolean  @default(true)
  canSubmitPO       Boolean  @default(true)
  canReviewExpenses Boolean  @default(true)
  canViewWages      Boolean  @default(false)
  canRecordPayments Boolean  @default(false)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("accountant_profiles")
}

model Employee {
  id           String              @id @default(cuid())
  employeeId   String              @unique // e.g. EMP-001
  userId       String?             @unique
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phone        String?
  department   String
  designation  String
  joiningDate  DateTime            @default(now())
  wageType     WageType            @default(MONTHLY)
  baseWageRate Decimal             @db.Decimal(12, 2)
  status       String              @default("ACTIVE")
  wageRecords  EmployeeWageRecord[]
  expenseClaims ExpenseClaim[]
  attendanceRecords AttendanceRecord[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("employees")
}

model VendorProfile {
  id                   String          @id @default(cuid())
  vendorId             String          @unique // e.g. VND-001, VND-002
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String
  contactPerson        String
  phone                String
  email                String?
  primaryLocation      String          // Must be one of the 8 whitelisted cities
  aadharNumber         String          // 12-digit Aadhaar
  panNumber            String          // 10-char PAN
  bankAccountNumber    String
  bankIfscCode         String
  bankAccountHolder    String
  bankName             String?
  bankBranch           String?
  isKycLocked          Boolean         @default(false)
  kycLockedAt          DateTime?
  status               String          @default("ACTIVE")
  purchaseOrders       PurchaseOrder[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("vendor_profiles")
}

model Supplier {
  id             String          @id @default(cuid())
  supplierCode   String          @unique // e.g. SUP-001
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  country        String          @default("India")
  category       String          @default("Wholesale Fruits")
  paymentTerms   String          @default("Net 30")
  status         String          @default("ACTIVE")
  notes          String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("suppliers")
}

model PurchaseOrder {
  id                   String                        @id @default(cuid())
  poNumber             String                        @unique // e.g. PO/SF/2026/001
  poDate               DateTime                      @default(now())
  expectedDeliveryDate DateTime?
  supplierId           String
  supplier             Supplier                      @relation(fields: [supplierId], references: [id])
  vendorProfileId      String?
  vendorProfile        VendorProfile?                @relation(fields: [vendorProfileId], references: [id])
  createdById          String
  createdBy            User                          @relation("POCreator", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           User?                         @relation("POApprover", fields: [approvedById], references: [id])
  deliveryAddress      String?
  orderPersonPlace     String?                       // Procurement Territory / Placement City (e.g. Hyderabad, Chennai, Warangal)
  paymentTerms         String?
  notes                String?
  paymentProofUrl      String?
  paymentProofNotes    String?
  dispatchVehicleNumber String?
  vehiclePhotoUrl      String?
  transportBillUrl     String?
  transporterName      String?
  driverPhone          String?
  dispatchDate         DateTime?
  dispatchStatus       PODispatchStatus              @default(PENDING_DISPATCH)
  autoAdvanceCalculated Decimal?                     @db.Decimal(14, 2)
  subtotal             Decimal                       @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal                       @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal                       @default(0) @db.Decimal(14, 2)
  grandTotal           Decimal                       @default(0) @db.Decimal(14, 2)
  advanceAmount        Decimal                       @default(0) @db.Decimal(14, 2)
  pendingAmount        Decimal                       @default(0) @db.Decimal(14, 2)
  status               POStatus                      @default(DRAFT)
  rejectionReason      String?
  items                PurchaseOrderItem[]
  statusHistory        PurchaseOrderStatusHistory[]
  financialRecord      PurchaseOrderFinancialRecord?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([vendorProfileId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fruitName       String
  category        String
  varietyGrade    String
  quantity        Decimal       @db.Decimal(12, 2)
  unit            String        @default("KG") // KG, BOX, CRATE, TON
  ratePerUnit     Decimal       @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)

  @@map("purchase_order_items")
}

model PurchaseOrderStatusHistory {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  status          POStatus
  changedById     String
  comment         String?
  createdAt       DateTime      @default(now())

  @@map("purchase_order_status_history")
}

model PurchaseOrderFinancialRecord {
  id                     String          @id @default(cuid())
  purchaseOrderId        String          @unique
  purchaseOrder          PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  verifiedCost           Decimal?        @db.Decimal(14, 2)
  costNotes              String?
  allocatedTransportCost Decimal?        @default(0) @db.Decimal(14, 2)
  allocatedLaborCost     Decimal?        @default(0) @db.Decimal(14, 2)
  linkedRevenue          Decimal?        @db.Decimal(14, 2)
  revenueNotes           String?
  realizedProfitLoss     Decimal?        @db.Decimal(14, 2)
  financialStatus        FinancialStatus @default(PENDING_COST_DATA)
  updatedById            String?
  updatedAt              DateTime        @updatedAt

  @@map("purchase_order_financial_records")
}

model EmployeeWageRecord {
  id               String        @id @default(cuid())
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payPeriod        String        // e.g. "November 2026"
  wageType         WageType
  wageRate         Decimal       @db.Decimal(12, 2)
  workedUnits      Decimal?      @db.Decimal(8, 2)
  grossAmount      Decimal       @db.Decimal(12, 2)
  deductions       Decimal       @default(0) @db.Decimal(12, 2)
  deductionNotes   String?
  netPayable       Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  balanceRemaining Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  payments         WagePayment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([employeeId])
  @@index([payPeriod])
  @@map("employee_wage_records")
}

model WagePayment {
  id             String             @id @default(cuid())
  wageRecordId   String
  wageRecord     EmployeeWageRecord @relation(fields: [wageRecordId], references: [id], onDelete: Cascade)
  amount         Decimal            @db.Decimal(12, 2)
  paymentDate    DateTime           @default(now())
  paymentMethod  String             @default("Bank Transfer")
  transactionRef String
  notes          String?
  recordedById   String
  receiptNumber  String             @unique
  createdAt      DateTime           @default(now())

  @@map("wage_payments")
}

model ExpenseClaim {
  id                String           @id @default(cuid())
  claimNumber       String           @unique // e.g. EXP/SF/2026/001
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenseDate       DateTime
  category          String
  description       String
  businessPurpose   String
  travelFrom        String?
  travelTo          String?
  amountSpent       Decimal          @db.Decimal(12, 2)
  approvedAmount    Decimal          @default(0) @db.Decimal(12, 2)
  amountPaid        Decimal          @default(0) @db.Decimal(12, 2)
  balanceRemaining  Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethodUsed String?
  receiptUrl        String?
  status            ExpenseStatus    @default(SUBMITTED)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  approvedById      String?
  approvedAt        DateTime?
  payments          ExpensePayment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("expense_claims")
}

model ExpensePayment {
  id             String        @id @default(cuid())
  expenseClaimId String
  expenseClaim   ExpenseClaim  @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @default(now())
  paymentMethod  String        @default("Bank Transfer")
  transactionRef String
  notes          String?
  recordedById   String
  receiptNumber  String        @unique
  createdAt      DateTime      @default(now())

  @@map("expense_payments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userRole   String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientRole String?  // ALL, ADMIN, ACCOUNTANT, EMPLOYEE
  title         String
  message       String
  type          String   @default("INFO")
  linkUrl       String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([recipientRole])
  @@map("notifications")
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@map("application_settings")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  SALES
  PURCHASE
  EXPORT
  IMPORT
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // e.g. INV/SF/2026/001
  invoiceType     InvoiceType   @default(SALES)
  partyName       String        // Customer, Consignee, or Supplier
  partyGst        String?
  partyAddress    String?
  partyEmail      String?
  partyPhone      String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  linkedPoNumber  String?
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxRate         Decimal       @default(5) @db.Decimal(5, 2) // Standard 5% GST for fruits
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  freightShipping Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue      Decimal       @default(0) @db.Decimal(14, 2)
  status          InvoiceStatus @default(PENDING)
  paymentTerms    String?       @default("Net 15 Days")
  paymentMethod   String?
  notes           String?
  items           InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String   // e.g. "Shimla Royal Delicious Apples (Grade A)"
  hsnCode     String?  @default("08081000") // HSN code for fresh apples
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String   @default("BOX") // BOX, KG, TON, CRATE
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(14, 2)

  @@map("invoice_items")
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  date         DateTime         @db.Date
  clockInTime      DateTime         @default(now())
  clockOutTime     DateTime?
  totalMinutes     Int?             @default(0)
  status           AttendanceStatus @default(PRESENT)
  photoUrl         String?
  clockOutPhotoUrl String?
  location         String?          @default("3-4-693/5/1/A/1, Raipura, Kakatiya colony, Hanamkonda, Telangana, 506011")
  clockInIp        String?
  notes            String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@index([status])
  @@map("attendance_records")
}



