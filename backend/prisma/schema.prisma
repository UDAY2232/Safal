datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  VENDOR
}

enum WageType {
  MONTHLY
  DAILY
  HOURLY
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  OPEN
  CLOSED
  REJECTED
  CANCELLED
}

enum PODispatchStatus {
  PENDING_DISPATCH
  LOADED_AND_DISPATCHED
  IN_TRANSIT
  DELIVERED_AT_HUB
  REJECTED_TRANSIT
}

enum FinancialStatus {
  NOT_CALCULATED
  PENDING_COST_DATA
  PENDING_SALES_DATA
  IN_PROGRESS
  PROFIT
  LOSS
  BREAK_EVEN
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAYMENT_PENDING
  PARTIALLY_REIMBURSED
  PAID_CLEARED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  name             String
  role             Role               @default(EMPLOYEE)
  department       String?
  designation      String?
  phone            String?
  isActive         Boolean            @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  accountantProfile AccountantProfile?
  employee         Employee?
  vendorProfile    VendorProfile?
  createdPOs       PurchaseOrder[]    @relation("POCreator")
  approvedPOs      PurchaseOrder[]    @relation("POApprover")
  auditLogs        AuditLog[]
  notifications    Notification[]
  attendanceRecords AttendanceRecord[]

  @@map("users")
}

model AccountantProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountantId      String   @unique // e.g. ACC-001
  canCreatePO       Boolean  @default(true)
  canSubmitPO       Boolean  @default(true)
  canReviewExpenses Boolean  @default(true)
  canViewWages      Boolean  @default(false)
  canRecordPayments Boolean  @default(false)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("accountant_profiles")
}

model Employee {
  id           String              @id @default(cuid())
  employeeId   String              @unique // e.g. EMP-001
  userId       String?             @unique
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phone        String?
  department   String
  designation  String
  joiningDate  DateTime            @default(now())
  wageType     WageType            @default(MONTHLY)
  baseWageRate Decimal             @db.Decimal(12, 2)
  status       String              @default("ACTIVE")
  wageRecords  EmployeeWageRecord[]
  expenseClaims ExpenseClaim[]
  attendanceRecords AttendanceRecord[]
  fieldAreaAssignments FieldAreaAssignment[]
  registeredSellers     FieldSeller[]                  @relation("RegisteredSellers")
  assignedSellers       FieldSeller[]                  @relation("AssignedSellers")
  sellerOrders          FieldSellerOrder[]
  sellerTransfersFrom   FieldSellerAssignmentHistory[] @relation("TransferredFromSellers")
  sellerTransfersTo     FieldSellerAssignmentHistory[] @relation("TransferredToSellers")
  fieldVisits           FieldVisit[]
  sellerFeedbacks       FieldSellerFeedback[]
  dailyFieldReports     DailyFieldReport[]
  performancePoints     FieldPerformancePoint[]
  monthlyTargets        EmployeeMonthlyTarget[]
  salaryDeductions      AttendanceSalaryDeduction[]
  attendanceCorrections AttendanceCorrectionRequest[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("employees")
}

model VendorProfile {
  id                   String          @id @default(cuid())
  vendorId             String          @unique // e.g. VND-001, VND-002
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String
  contactPerson        String
  phone                String
  email                String?
  primaryLocation      String          // Must be one of the 8 whitelisted cities
  aadharNumber         String          // 12-digit Aadhaar
  panNumber            String          // 10-char PAN
  bankAccountNumber    String
  bankIfscCode         String
  bankAccountHolder    String
  bankName             String?
  bankBranch           String?
  isKycLocked          Boolean         @default(false)
  kycLockedAt          DateTime?
  status               String          @default("ACTIVE")
  purchaseOrders       PurchaseOrder[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("vendor_profiles")
}

model Supplier {
  id             String          @id @default(cuid())
  supplierCode   String          @unique // e.g. SUP-001
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  country        String          @default("India")
  category       String          @default("Wholesale Fruits")
  paymentTerms   String          @default("Net 30")
  status         String          @default("ACTIVE")
  notes          String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("suppliers")
}

model PurchaseOrder {
  id                   String                        @id @default(cuid())
  poNumber             String                        @unique // e.g. PO/SF/2026/001
  poDate               DateTime                      @default(now())
  expectedDeliveryDate DateTime?
  supplierId           String
  supplier             Supplier                      @relation(fields: [supplierId], references: [id])
  vendorProfileId      String?
  vendorProfile        VendorProfile?                @relation(fields: [vendorProfileId], references: [id])
  createdById          String
  createdBy            User                          @relation("POCreator", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           User?                         @relation("POApprover", fields: [approvedById], references: [id])
  deliveryAddress      String?
  orderPersonPlace     String?                       // Procurement Territory / Placement City (e.g. Hyderabad, Chennai, Warangal)
  paymentTerms         String?
  notes                String?
  paymentProofUrl      String?
  paymentProofNotes    String?
  dispatchVehicleNumber String?
  vehiclePhotoUrl      String?
  transportBillUrl     String?
  transporterName      String?
  driverPhone          String?
  dispatchDate         DateTime?
  dispatchStatus       PODispatchStatus              @default(PENDING_DISPATCH)
  autoAdvanceCalculated Decimal?                     @db.Decimal(14, 2)
  // Weighbridge & Quality Control (QC) Hub Inspection Records
  weighbridgeGrossKg   Decimal?                      @db.Decimal(12, 2)
  weighbridgeTareKg    Decimal?                      @db.Decimal(12, 2)
  weighbridgeNetKg     Decimal?                      @db.Decimal(12, 2)
  weighbridgeSlipUrl   String?
  qcInspectionStatus   String?                       // 'PASSED', 'REJECTED_TRANSIT', 'GRADE_DOWNGRADED'
  qcGradeARatio        Decimal?                      @db.Decimal(5, 2) // e.g. 96.50 (%)
  qcGradeBRatio        Decimal?                      @db.Decimal(5, 2) // e.g. 3.50 (%)
  qcWastageKg          Decimal?                      @db.Decimal(12, 2)
  qcInspectorName      String?
  qcInspectionDate     DateTime?
  qcInspectionRemarks  String?
  subtotal             Decimal                       @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal                       @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal                       @default(0) @db.Decimal(14, 2)
  grandTotal           Decimal                       @default(0) @db.Decimal(14, 2)
  advanceAmount        Decimal                       @default(0) @db.Decimal(14, 2)
  pendingAmount        Decimal                       @default(0) @db.Decimal(14, 2)
  creatorRole          String                        @default("ADMIN") // 'ADMIN', 'VENDOR', 'ACCOUNTANT', 'EMPLOYEE'
  safalCommissionRate  Decimal                       @default(0) @db.Decimal(5, 2) // 5.00 for Vendor PO, 0.00 for Admin PO
  safalCommissionAmount Decimal                      @default(0) @db.Decimal(14, 2)
  apmcCommissionRate   Decimal                       @default(0) @db.Decimal(5, 2) // 1.00 for Vendor PO, 0.00 for Admin PO
  apmcCommissionAmount Decimal                       @default(0) @db.Decimal(14, 2)
  totalCommissionAmount Decimal                      @default(0) @db.Decimal(14, 2)
  netPayableAmount     Decimal                       @default(0) @db.Decimal(14, 2) // PO Amount - Total Commission (or configured settlement)
  commissionSettlementRule String                    @default("DEDUCTION_FROM_PAYABLE") // 'DEDUCTION_FROM_PAYABLE' | 'ADDITIONAL_SURCHARGE'
  status               POStatus                      @default(DRAFT)
  rejectionReason      String?
  items                PurchaseOrderItem[]
  statusHistory        PurchaseOrderStatusHistory[]
  financialRecord      PurchaseOrderFinancialRecord?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([vendorProfileId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fruitName       String
  category        String
  varietyGrade    String
  quantity        Decimal       @db.Decimal(12, 2)
  unit            String        @default("KG") // KG, BOX, CRATE, TON
  ratePerUnit     Decimal       @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)

  @@map("purchase_order_items")
}

model PurchaseOrderStatusHistory {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  status          POStatus
  changedById     String
  comment         String?
  createdAt       DateTime      @default(now())

  @@map("purchase_order_status_history")
}

model PurchaseOrderFinancialRecord {
  id                     String          @id @default(cuid())
  purchaseOrderId        String          @unique
  purchaseOrder          PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  verifiedCost           Decimal?        @db.Decimal(14, 2)
  costNotes              String?
  allocatedTransportCost Decimal?        @default(0) @db.Decimal(14, 2)
  allocatedLaborCost     Decimal?        @default(0) @db.Decimal(14, 2)
  linkedRevenue          Decimal?        @db.Decimal(14, 2)
  revenueNotes           String?
  realizedProfitLoss     Decimal?        @db.Decimal(14, 2)
  financialStatus        FinancialStatus @default(PENDING_COST_DATA)
  updatedById            String?
  updatedAt              DateTime        @updatedAt

  @@map("purchase_order_financial_records")
}

model EmployeeWageRecord {
  id               String        @id @default(cuid())
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payPeriod        String        // e.g. "November 2026"
  wageType         WageType
  wageRate         Decimal       @db.Decimal(12, 2)
  workedUnits      Decimal?      @db.Decimal(8, 2)
  grossAmount      Decimal       @db.Decimal(12, 2)
  deductions       Decimal       @default(0) @db.Decimal(12, 2)
  deductionNotes   String?
  netPayable       Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  balanceRemaining Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  payments         WagePayment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([employeeId])
  @@index([payPeriod])
  @@map("employee_wage_records")
}

model WagePayment {
  id             String             @id @default(cuid())
  wageRecordId   String
  wageRecord     EmployeeWageRecord @relation(fields: [wageRecordId], references: [id], onDelete: Cascade)
  amount         Decimal            @db.Decimal(12, 2)
  paymentDate    DateTime           @default(now())
  paymentMethod  String             @default("Bank Transfer")
  transactionRef String
  notes          String?
  recordedById   String
  receiptNumber  String             @unique
  createdAt      DateTime           @default(now())

  @@map("wage_payments")
}

model ExpenseClaim {
  id                String           @id @default(cuid())
  claimNumber       String           @unique // e.g. EXP/SF/2026/001
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenseDate       DateTime
  category          String
  description       String
  businessPurpose   String
  travelFrom        String?
  travelTo          String?
  amountSpent       Decimal          @db.Decimal(12, 2)
  approvedAmount    Decimal          @default(0) @db.Decimal(12, 2)
  amountPaid        Decimal          @default(0) @db.Decimal(12, 2)
  balanceRemaining  Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethodUsed String?
  receiptUrl        String?
  status            ExpenseStatus    @default(SUBMITTED)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  approvedById      String?
  approvedAt        DateTime?
  payments          ExpensePayment[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("expense_claims")
}

model ExpensePayment {
  id             String        @id @default(cuid())
  expenseClaimId String
  expenseClaim   ExpenseClaim  @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @default(now())
  paymentMethod  String        @default("Bank Transfer")
  transactionRef String
  notes          String?
  recordedById   String
  receiptNumber  String        @unique
  createdAt      DateTime      @default(now())

  @@map("expense_payments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userRole   String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientRole String?  // ALL, ADMIN, ACCOUNTANT, EMPLOYEE
  title         String
  message       String
  type          String   @default("INFO")
  linkUrl       String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([recipientRole])
  @@map("notifications")
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@map("application_settings")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  SALES
  PURCHASE
  EXPORT
  IMPORT
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // e.g. INV/SF/2026/001
  invoiceType     InvoiceType   @default(SALES)
  partyName       String        // Customer, Consignee, or Supplier
  partyGst        String?
  partyAddress    String?
  partyEmail      String?
  partyPhone      String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  linkedPoNumber  String?
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxRate         Decimal       @default(5) @db.Decimal(5, 2) // Standard 5% GST for fruits
  taxAmount       Decimal       @default(0) @db.Decimal(14, 2)
  freightShipping Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  balanceDue      Decimal       @default(0) @db.Decimal(14, 2)
  status          InvoiceStatus @default(PENDING)
  paymentTerms    String?       @default("Net 15 Days")
  paymentMethod   String?
  notes           String?
  items           InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String   // e.g. "Shimla Royal Delicious Apples (Grade A)"
  hsnCode     String?  @default("08081000") // HSN code for fresh apples
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String   @default("BOX") // BOX, KG, TON, CRATE
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(14, 2)

  @@map("invoice_items")
}

model AttendanceRecord {
  id                   String                        @id @default(cuid())
  userId               String
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId           String?
  employee             Employee?                     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  date                 DateTime                      @db.Date
  clockInTime          DateTime                      @default(now())
  clockOutTime         DateTime?
  totalMinutes         Int?                          @default(0)
  status               AttendanceStatus              @default(PRESENT)
  photoUrl             String?
  clockOutPhotoUrl     String?
  location             String?                       @default("3-4-693/5/1/A/1, Raipura, Kakatiya colony, Hanamkonda, Telangana, 506011")
  clockInIp            String?
  notes                String?

  // GPS & Geofence Verification Fields
  latitude             Decimal?                      @db.Decimal(10, 7)
  longitude            Decimal?                      @db.Decimal(10, 7)
  gpsAccuracyMeters    Decimal?                      @db.Decimal(8, 2)
  workplaceLocationId  String?
  workplaceLocation    WorkplaceLocation?            @relation(fields: [workplaceLocationId], references: [id], onDelete: SetNull)
  workplaceName        String?
  distanceMeters       Int?
  locationStatus       String                        @default("VERIFIED") // VERIFIED, OUT_OF_BOUNDS, GPS_ACCURACY_LOW, MANUAL_EXCEPTION

  // Shift & Late Arrival Penalty Fields
  assignedShiftName    String?
  shiftStartTime       String?                       // e.g. "05:30 AM"
  shiftEndTime         String?                       // e.g. "02:00 PM"
  lateMinutes          Int                           @default(0)
  penaltyAmount        Decimal                       @default(0) @db.Decimal(10, 2)
  penaltyWaived        Boolean                       @default(false)
  waiverReason         String?

  // Relations to Payroll Deduction & Correction Requests
  payrollDeduction     AttendanceSalaryDeduction?
  correctionRequests   AttendanceCorrectionRequest[]

  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@index([employeeId])
  @@index([status])
  @@map("attendance_records")
}

model WorkplaceLocation {
  id                  String             @id @default(cuid())
  name                String             @unique // e.g. "SAFAL Central Hub & Cold Storage"
  address             String
  latitude            Decimal            @db.Decimal(10, 7)
  longitude           Decimal            @db.Decimal(10, 7)
  allowedRadiusMeters Int                @default(100)
  isActive            Boolean            @default(true)
  attendanceRecords   AttendanceRecord[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("workplace_locations")
}

model AttendancePolicyConfig {
  id                      String    @id @default(cuid())
  gracePeriodMinutes      Int       @default(59) // Under 1 hour (<=59 min) is ₹0 penalty
  penaltyPerHourAmount    Decimal   @default(100) @db.Decimal(10, 2) // ₹100 per completed hour
  maxDailyPenalty         Decimal?  @db.Decimal(10, 2)
  requireGps              Boolean   @default(true)
  maxAllowedAccuracyMeters Int      @default(150)
  updatedById             String?
  updatedAt               DateTime  @updatedAt

  @@map("attendance_policy_configs")
}

model AttendanceSalaryDeduction {
  id                  String           @id @default(cuid())
  attendanceRecordId  String           @unique
  attendanceRecord    AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                DateTime         @db.Date
  lateDurationMinutes Int
  penaltyAmount       Decimal          @db.Decimal(10, 2)
  status              String           @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, WAIVED, APPLIED_TO_PAYROLL
  payPeriodMonthYear  String           // e.g. "2026-11"
  wageRecordId        String?
  notes               String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([employeeId])
  @@index([payPeriodMonthYear])
  @@index([status])
  @@map("attendance_salary_deductions")
}

model AttendanceCorrectionRequest {
  id                  String           @id @default(cuid())
  attendanceRecordId  String
  attendanceRecord    AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedTime       DateTime?
  reason              String
  status              String           @default("PENDING") // PENDING, APPROVED, REJECTED
  adminComments       String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([attendanceRecordId])
  @@index([employeeId])
  @@index([status])
  @@map("attendance_correction_requests")
}

// ==========================================
// SAFAL ERP – FIELD WORK & SELLER MANAGEMENT
// ==========================================

model FieldArea {
  id          String                 @id @default(cuid())
  name        String                 @unique
  district    String?
  state       String                 @default("Telangana")
  isActive    Boolean                @default(true)
  assignments FieldAreaAssignment[]
  sellers     FieldSeller[]
  sellerOrders FieldSellerOrder[]
  visits      FieldVisit[]
  dailyReports DailyFieldReport[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("field_areas")
}

model FieldAreaAssignment {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  areaId       String
  area         FieldArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedAt   DateTime  @default(now())
  isActive     Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, areaId])
  @@map("field_area_assignments")
}

model FieldSeller {
  id                   String                         @id @default(cuid())
  sellerCode           String                         @unique // e.g. FSL-001
  shopName             String
  ownerName            String
  mobile               String
  whatsapp             String?
  address              String
  areaId               String
  area                 FieldArea                      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  businessType         String                         @default("RETAILER") // RETAILER, WHOLESALER, DISTRIBUTOR, OTHER
  fruitsInterested     String                         @default("[]") // JSON string of fruit names
  estMonthlyQtyKg      Decimal?                       @db.Decimal(12, 2)
  estMonthlyValue      Decimal?                       @db.Decimal(12, 2)
  firstContactDate     DateTime                       @default(now())
  interestLevel        String                         @default("WARM") // HOT, WARM, COLD
  stage                String                         @default("LEAD_IDENTIFIED") // LEAD_IDENTIFIED, FIRST_CONTACT, INTERESTED, FOLLOW_UP, REGISTERED, FIRST_PURCHASE, REPEAT_CUSTOMER
  registeredEmployeeId String
  registeredEmployee   Employee                       @relation("RegisteredSellers", fields: [registeredEmployeeId], references: [id], onDelete: Restrict)
  assignedEmployeeId   String?
  assignedEmployee     Employee?                      @relation("AssignedSellers", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  isVerified           Boolean                        @default(false)
  verifiedById         String?
  verifiedAt           DateTime?
  notes                String?
  totalPurchaseValue   Decimal                        @default(0) @db.Decimal(12, 2)
  purchaseCount        Int                            @default(0)
  firstPurchaseDate    DateTime?
  lastPurchaseDate     DateTime?
  firstPurchaseAmount  Decimal?                       @db.Decimal(12, 2)
  visits               FieldVisit[]
  feedbacks            FieldSellerFeedback[]
  orders               FieldSellerOrder[]
  assignmentHistory    FieldSellerAssignmentHistory[]
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  @@index([mobile])
  @@index([areaId])
  @@index([registeredEmployeeId])
  @@index([assignedEmployeeId])
  @@index([stage])
  @@map("field_sellers")
}

model FieldSellerOrder {
  id               String                 @id @default(cuid())
  orderNumber      String                 @unique // e.g. ORD/SF/2026/001
  sellerId         String
  seller           FieldSeller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  employeeId       String                 // Employee attribution
  employee         Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  areaId           String
  area             FieldArea              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  orderDate        DateTime               @default(now())
  fruitNames       String                 // e.g. "Kashmir Apples (Grade A), Shimla Royal"
  totalQuantityKg  Decimal                @default(0) @db.Decimal(12, 2)
  orderValue       Decimal                @default(0) @db.Decimal(14, 2)
  paidAmount       Decimal                @default(0) @db.Decimal(14, 2)
  dueAmount        Decimal                @default(0) @db.Decimal(14, 2)
  paymentStatus    String                 @default("PAID") // PAID, PARTIAL, PENDING
  orderStatus      String                 @default("COMPLETED") // COMPLETED, DELIVERED, CANCELLED
  linkedPoId       String?                // Reference to PurchaseOrder if linked
  linkedInvoiceId  String?                // Reference to Invoice if linked
  isVerified       Boolean                @default(true)
  verifiedById     String?
  notes            String?
  items            FieldSellerOrderItem[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([sellerId])
  @@index([employeeId])
  @@index([areaId])
  @@index([orderDate])
  @@index([orderStatus])
  @@map("field_seller_orders")
}

model FieldSellerOrderItem {
  id               String           @id @default(cuid())
  orderId          String
  order            FieldSellerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fruitName        String
  quantity         Decimal          @db.Decimal(12, 2)
  unit             String           @default("BOX")
  rate             Decimal          @db.Decimal(12, 2)
  amount           Decimal          @db.Decimal(14, 2)

  @@index([orderId])
  @@map("field_seller_order_items")
}

model FieldSellerAssignmentHistory {
  id              String       @id @default(cuid())
  sellerId        String
  seller          FieldSeller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  fromEmployeeId  String?
  fromEmployee    Employee?    @relation("TransferredFromSellers", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  toEmployeeId    String
  toEmployee      Employee     @relation("TransferredToSellers", fields: [toEmployeeId], references: [id], onDelete: Restrict)
  transferredById String?
  transferredAt   DateTime     @default(now())
  reason          String?

  @@index([sellerId])
  @@map("field_seller_assignment_history")
}

model FieldVisit {
  id                   String      @id @default(cuid())
  sellerId             String
  seller               FieldSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  areaId               String
  area                 FieldArea   @relation(fields: [areaId], references: [id], onDelete: Restrict)
  visitDate            DateTime    @default(now())
  purpose              String
  discussionSummary    String
  fruitsDiscussed      String?
  customerRequirements String?
  feedbackText         String?
  nextFollowUpDate     DateTime?
  status               String      @default("INTERESTED") // INTERESTED, FOLLOW_UP_REQUIRED, NOT_INTERESTED, CONVERTED
  photoUrl             String?
  isVerified           Boolean     @default(false)
  pointsAwarded        Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([sellerId])
  @@index([employeeId])
  @@index([visitDate])
  @@map("field_visits")
}

model FieldSellerFeedback {
  id                  String      @id @default(cuid())
  sellerId            String
  seller              FieldSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  visitId             String?
  qualityRating       Int?
  pricingRating       Int?
  availabilityRating  Int?
  deliveryRating      Int?
  overallSatisfaction Int         @default(4)
  suggestions         String?
  complaintDetails    String?
  isResolved          Boolean     @default(true)
  followUpRequired    Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("field_seller_feedbacks")
}

model DailyFieldReport {
  id                  String    @id @default(cuid())
  reportDate          DateTime  @db.Date
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  areaId              String
  area                FieldArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  shopsVisited        Int       @default(0)
  newSellersContacted Int       @default(0)
  sellersRegistered   Int       @default(0)
  interestedSellers   Int       @default(0)
  followUpsCompleted  Int       @default(0)
  purchaseConversions Int       @default(0)
  majorAchievements   String?
  problemsFaced       String?
  tomorrowPlan        String?
  status              String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  reviewedById        String?
  reviewedAt          DateTime?
  reviewComments      String?
  pointsAwarded       Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([employeeId, reportDate, areaId])
  @@index([reportDate])
  @@index([employeeId])
  @@map("daily_field_reports")
}

model FieldPerformancePoint {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  points      Int
  actionType  String   // UNIQUE_VISIT, NEW_SELLER_REG, FIRST_PURCHASE, REPEAT_PURCHASE, DAILY_REPORT, MANUAL_ADJUSTMENT
  referenceId String?
  reason      String
  monthYear   String   // e.g. "2026-11"
  awardedById String?
  createdAt   DateTime @default(now())

  @@index([employeeId, monthYear])
  @@map("field_performance_points")
}

model FieldScoringConfig {
  id                   String   @id @default(cuid())
  uniqueVisitPoints    Int      @default(5)
  newSellerRegPoints   Int      @default(10)
  firstPurchasePoints  Int      @default(50)
  repeatPurchasePoints Int      @default(20)
  dailyReportPoints    Int      @default(5)
  updatedAt            DateTime @updatedAt

  @@map("field_scoring_configs")
}

model EmployeeMonthlyTarget {
  id                        String   @id @default(cuid())
  employeeId                String
  employee                  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthYear                 String   // "2026-11"
  targetShopsVisited        Int      @default(100)
  targetSellersRegistered   Int      @default(20)
  targetConvertedPurchasers Int      @default(5)
  targetPurchaseValue       Decimal  @default(500000) @db.Decimal(12, 2)
  targetPoints              Int      @default(500)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([employeeId, monthYear])
  @@map("employee_monthly_targets")
}



